generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  TECHNICAL_EXAM
  OFFER
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(80)
  email        String        @unique @db.VarChar(254)
  passwordHash String
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([createdAt, id])
}

model Application {
  id          String            @id @default(cuid())
  company     String            @db.VarChar(120)
  position    String            @db.VarChar(160)
  location    String            @db.VarChar(160)
  jobUrl      String            @db.VarChar(2048)
  salary      String?           @db.VarChar(120)
  appliedDate DateTime           @db.Date
  status      ApplicationStatus @default(SAVED)
  notes       String?           @db.VarChar(10000)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([createdAt, id])
  @@index([status, createdAt])
  @@index([appliedDate])
}

// Shared across serverless instances; no process-local authentication throttling.
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
